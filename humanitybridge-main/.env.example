# Application
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
VITE_HMR_PORT=26000

# Database: SQLite is for local development; production uses MySQL 8.
USE_MYSQL=true
DATABASE_URL=mysql://root:@127.0.0.1:3306/humanitybridge_db
SQLITE_DB_PATH=./data/humanitybridge.db
MYSQL_DATABASE=humanitybridge_db
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Production secrets: generate each independently with a cryptographically secure generator.
SESSION_SECRET=
CSRF_SECRET=
SIGNED_URL_SECRET=
# Exactly 32 random bytes encoded as 64 hexadecimal characters.
MFA_ENCRYPTION_KEY=
COOKIE_SECURE=false
SESSION_TTL_HOURS=24

# First-time development seed only; never use demo credentials in production.
ADMIN_BOOTSTRAP_EMAIL=Admin@humanitybridge.org
ADMIN_BOOTSTRAP_PASSWORD=
OWNER_ADMIN_INITIAL_PASSWORD=
SEED_COORDINATOR_PASSWORD=

# The current adapter is sandbox-only. Production startup rejects sandbox mode.
PAYMENT_PROVIDER=disabled

# Email integration (not enabled until a provider is configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

PRIVATE_STORAGE_DIR=./storage/private
PUBLIC_MEDIA_DIR=./storage/public
GEMINI_API_KEY=
