# Application Environment
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# MySQL 8 Database Configuration (Production / Docker)
# When DATABASE_URL is omitted in local sandbox mode, HumanityBridge uses embedded relational SQLite via Drizzle.
DATABASE_URL="mysql://humanitybridge:change_me_db_password@127.0.0.1:3306/humanitybridge"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_DATABASE="humanitybridge"
MYSQL_USER="humanitybridge"
MYSQL_PASSWORD="change_me_db_password"

# Security & Session Configuration
SESSION_SECRET="replace-with-64-char-cryptographically-random-secret"
CSRF_SECRET="replace-with-64-char-csrf-hmac-secret"
COOKIE_SECURE="false"
SESSION_TTL_HOURS="24"

# Initial Administrator Bootstrap (required only for first-time CLI bootstrap)
ADMIN_BOOTSTRAP_EMAIL="admin@humanitybridge.org"
ADMIN_BOOTSTRAP_PASSWORD="replace-with-strong-initial-password"

# Payment Gateway Configuration (Sandbox Adapter active when unset)
PAYMENT_PROVIDER="sandbox"
PAYMENT_WEBHOOK_SECRET="replace-with-provider-webhook-hmac-secret"

# Email Provider Configuration (Configurable SMTP / Transactional API)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@humanitybridge.org"

# Private Storage & Media Paths
PRIVATE_STORAGE_DIR="./storage/private"
PUBLIC_MEDIA_DIR="./storage/public"
SIGNED_URL_SECRET="replace-with-signed-media-secret"

# Optional AI-Assisted Translation (Human editorial review mandatory)
GEMINI_API_KEY=""
