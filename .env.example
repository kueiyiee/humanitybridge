# HumanityBridge — local development defaults
# Node.js 22.13+ is required for the built-in node:sqlite DatabaseSync API.
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
VITE_HMR_PORT=26000

# SQLite is the default for local development. The database is created automatically.
USE_MYSQL=false
DATABASE_URL=
SQLITE_DB_PATH=./data/humanitybridge.db

# Local-only development settings. Production must use independently generated secrets.
SESSION_SECRET=
CSRF_SECRET=
SIGNED_URL_SECRET=
# Exactly 32 random bytes encoded as 64 hexadecimal characters when using production MFA.
MFA_ENCRYPTION_KEY=
COOKIE_SECURE=false
SESSION_TTL_HOURS=24

# Optional first-time owner account. Set a unique password locally before running owner:configure.
OWNER_ADMIN_INITIAL_PASSWORD=
# Used only by the optional synthetic development seed; do not seed public demo content into a live environment.
ADMIN_BOOTSTRAP_EMAIL=admin@humanitybridge.local
ADMIN_BOOTSTRAP_PASSWORD=
SEED_COORDINATOR_PASSWORD=

# Online payment processing remains disabled.
PAYMENT_PROVIDER=disabled

# Local development media storage.
MEDIA_STORAGE_PROVIDER=local
PRIVATE_STORAGE_DIR=./storage/private
PUBLIC_MEDIA_DIR=./storage/public
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

STORY_IMAGE_ALLOWED_HOSTS=images.unsplash.com,images.pexels.com,cdn.pixabay.com
GEMINI_API_KEY=

# Production-only MySQL variables (leave unset for SQLite development).
# USE_MYSQL=true
# DATABASE_URL=mysql://user:password@host:3306/humanitybridge
